{
    "name": "softtan/toolbox",
    "description": "Pacote com classes contendo funções com ferramentas para auxiliar no desenvolvimento de Software em PHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Softtan\\Toolbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softtan\\Toolbox\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Levi Tancredo",
            "email": "levitancredo@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0"
    }    
}